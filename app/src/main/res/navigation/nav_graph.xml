<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Authentication Fragments -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.flightinfo.app.ui.fragment.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_mainFragment"
            app:destination="@id/flightListFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.flightinfo.app.ui.fragment.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_mainFragment"
            app:destination="@id/flightListFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.flightinfo.app.ui.fragment.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- Main App Fragments -->
    <fragment
        android:id="@+id/flightListFragment"
        android:name="com.flightinfo.app.ui.fragment.FlightListFragment"
        android:label="Flight List"
        tools:layout="@layout/fragment_flight_list">
        <action
            android:id="@+id/action_flightListFragment_to_travelSuggestionFragment"
            app:destination="@id/travelSuggestionFragment" />
        <action
            android:id="@+id/action_flightListFragment_to_flightBookingFragment"
            app:destination="@id/flightBookingFragment" />
        <action
            android:id="@+id/action_flightListFragment_to_recommendationFragment"
            app:destination="@id/recommendationFragment" />
        <action
            android:id="@+id/action_flightListFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_flightListFragment_to_routeMapFragment"
            app:destination="@id/routeMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/routeMapFragment"
        android:name="com.flightinfo.app.ui.fragment.RouteMapFragment"
        android:label="Route Map"
        tools:layout="@layout/fragment_route_map" />
    
    <fragment
        android:id="@+id/recommendationFragment"
        android:name="com.flightinfo.app.ui.fragment.RecommendationFragment"
        android:label="智能推荐"
        tools:layout="@layout/fragment_recommendation">
        <action
            android:id="@+id/action_recommendationFragment_to_flightBookingFragment"
            app:destination="@id/flightBookingFragment" />
    </fragment>

    <fragment
        android:id="@+id/travelSuggestionFragment"
        android:name="com.flightinfo.app.ui.fragment.TravelSuggestionFragment"
        android:label="Travel Suggestion"
        tools:layout="@layout/fragment_travel_suggestion" />

    <fragment
        android:id="@+id/flightBookingFragment"
        android:name="com.flightinfo.app.ui.fragment.FlightBookingFragment"
        android:label="Flight Booking"
        tools:layout="@layout/fragment_flight_booking" />
    
    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="com.flightinfo.app.ui.fragment.NotificationSettingsFragment"
        android:label="Notification Settings"
        tools:layout="@layout/fragment_notification_settings" />

    <fragment
        android:id="@+id/priceTrackingFragment"
        android:name="com.flightinfo.app.ui.fragment.PriceTrackingFragment"
        android:label="Price Tracking"
        tools:layout="@layout/fragment_price_tracking" />
    
    <fragment
        android:id="@+id/airportLookupFragment"
        android:name="com.flightinfo.app.ui.fragment.AirportLookupFragment"
        android:label="Airport Lookup"
        tools:layout="@layout/fragment_airport_lookup" />
    
    <fragment
        android:id="@+id/offlineScheduleFragment"
        android:name="com.flightinfo.app.ui.fragment.OfflineScheduleFragment"
        android:label="Offline Schedule"
        tools:layout="@layout/fragment_offline_schedule" />
    <include app:graph="@navigation/history_nav_graph" />
</navigation>
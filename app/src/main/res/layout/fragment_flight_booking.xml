<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 乘客信息部分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="乘客信息"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="乘客姓名" />

        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="乘客邮箱"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/phoneEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="乘客电话"
            android:inputType="phone" />

        <EditText
            android:id="@+id/passengerIdEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="身份证号"
            android:inputType="number" />

        <!-- 天气信息部分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="天气信息"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/departureWeatherTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="出发地天气"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/departureWeatherInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="正在加载天气信息..."
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/arrivalWeatherTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="目的地天气"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/arrivalWeatherInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="正在加载天气信息..."
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/weatherImpactTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="天气影响"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weatherImpactInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="正在加载天气影响信息..."
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/viewWeatherDetailsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="查看天气详情" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 座位选择部分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="座位选择"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/seatEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="座位号" />

        <Button
            android:id="@+id/selectSeatButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择座位"
            android:layout_marginTop="8dp" />

        <!-- 行李信息部分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="行李信息"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="托运行李数量: "
                android:layout_gravity="center_vertical" />

            <NumberPicker
                android:id="@+id/checkedBaggagePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="随身行李数量: "
                android:layout_gravity="center_vertical" />

            <NumberPicker
                android:id="@+id/cabinBaggagePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <EditText
            android:id="@+id/specialBaggageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="特殊行李描述" />

        <!-- 餐食选择部分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="餐食选择"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/mealPreferenceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/meal_options" />

        <!-- 保险选项部分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保险选项"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/insuranceRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/noInsuranceRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无保险"
                android:checked="true" />

            <RadioButton
                android:id="@+id/basicInsuranceRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基础保险" />

            <RadioButton
                android:id="@+id/comprehensiveInsuranceRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="综合保险" />

            <RadioButton
                android:id="@+id/premiumInsuranceRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高级保险" />
        </RadioGroup>

        <!-- 特殊需求部分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="特殊需求"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/specialRequestsEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入特殊需求（可选）"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- 总价显示 -->
        <TextView
            android:id="@+id/totalPriceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总价：--"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="end"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/bookButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即预订"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>

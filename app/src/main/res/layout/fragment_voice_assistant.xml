<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp"
    tools:context=".ui.fragment.VoiceAssistantFragment">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/voice_assistant_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 语音助手状态指示器 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_status_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_assistant_ready"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/voice_assistant_language"
                android:textColor="@color/text_hint"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 语音按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_voice_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/voice_assistant_button"
        android:src="@drawable/ic_mic"
        app:backgroundTint="@color/primary"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 波形动画容器 -->
    <LinearLayout
        android:id="@+id/ll_wave_animation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fab_voice_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/bar1"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_margin="2dp"
            android:background="@color/primary"
            android:visibility="gone" />

        <View
            android:id="@+id/bar2"
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:layout_margin="2dp"
            android:background="@color/primary"
            android:visibility="gone" />

        <View
            android:id="@+id/bar3"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="@color/primary"
            android:visibility="gone" />

        <View
            android:id="@+id/bar4"
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:layout_margin="2dp"
            android:background="@color/primary"
            android:visibility="gone" />

        <View
            android:id="@+id/bar5"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_margin="2dp"
            android:background="@color/primary"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 当前命令显示 -->
    <TextView
        android:id="@+id/tv_current_command"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ll_wave_animation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="正在识别：查询航班CA1234"
        tools:visibility="visible" />

    <!-- 助手响应显示 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_response"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/tv_current_command"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_status_indicator">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="欢迎使用语音助手！您可以说：查询航班、航班状态、机场信息、设置提醒、天气查询等。" />

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <!-- 设置按钮 -->
    <ImageView
        android:id="@+id/iv_settings"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <!-- 历史记录按钮 -->
    <ImageView
        android:id="@+id/iv_history"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/history"
        android:src="@drawable/ic_history"
        app:layout_constraintEnd_toStartOf="@id/iv_settings"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <!-- 帮助按钮 -->
    <ImageView
        android:id="@+id/iv_help"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/help"
        android:src="@drawable/ic_help"
        app:layout_constraintEnd_toStartOf="@id/iv_history"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

</androidx.constraintlayout.widget.ConstraintLayout>